---
import Base from '../../layouts/Base.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){const entries=await getCollection('beitraege',({data})=>!data.draft);return entries.map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content}=await render(entry);
const label={gedanke:'Gedanke',reflexion:'Reflexion',essay:'Essay'}[entry.data.type];
---
<Base title={entry.data.title} description={entry.data.description??entry.data.title}><article class="article"><div class="meta"><span>{label}</span><span>·</span><time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('de-DE',{day:'2-digit',month:'long',year:'numeric'})}</time></div><h1>{entry.data.title}</h1><div class="article-body"><Content/></div>{entry.data.tags.length>0&&<div class="tags">{entry.data.tags.map(tag=><span>{tag}</span>)}</div>}<a class="back-link" href="/">← Zurück zur Startseite</a></article></Base>
